# Copy to .env and fill in. Never share this file.

# From the Fyers API dashboard (your "Algo trading app")
FYERS_APP_ID=ABCD1234-100
FYERS_SECRET=your_secret_here
FYERS_REDIRECT_URI=https://trade.fyers.in/api-login/redirect-uri/index.html

# Telegram (can reuse the Delta bot's token, but a separate bot keeps alerts apart)
TELEGRAM_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789

# true = paper trading (no real orders). Set false only when you are ready to go live.
PAPER_MODE=true
STARTING_CAPITAL=250000
# 0 = buy as many lots as the balance can margin; set a number to cap it
MAX_LOTS=0

# ALL F&O stocks, or a comma list of stocks like RELIANCE,SBIN,TCS (indices are never traded)
UNIVERSE=ALL

# Rough paper-mode charges per round trip (INR)
COST_PER_ROUND_TRIP=150
